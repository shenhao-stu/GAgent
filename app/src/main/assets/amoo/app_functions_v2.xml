<?xml version='1.0' encoding='utf-8'?>
<appfunctions>
  <appfunction>
    <id>com.ljq.ga.amoo.GaAppFunctionService#capabilities</id>
    <enabledByDefault>true</enabledByDefault>
    <description>GAgent 能做什么: 自动化操作手机界面，包括在微信里打开小程序、在小程序里逐页翻找、点击按钮、滑动列表、输入文字、截图看画面判断，完成多步骤任务。用户问「本机有没有能自动操作其他 App 界面、模拟点击、无障碍脚本」这类问题时用本工具查询。</description>
    <response>
      <id>unused</id>
      <valueType>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </valueType>
    </response>
    <functionId>com.ljq.ga.amoo.GaAppFunctionService#capabilities</functionId>
  </appfunction>
  <appfunction>
    <id>com.ljq.ga.amoo.GaAppFunctionService#startTask</id>
    <enabledByDefault>true</enabledByDefault>
    <description>自动化操作手机界面: 代替用户在微信等 App 里点击、滑动、输入、截图判断，完成多步骤任务。能做到: 打开微信、搜索聊天/公众号/小程序、进入小程序、在小程序里逐页翻找、点按钮、填表, 并把结果原样报回来。用户说「去微信…」「打开微信…」「在微信里…」「进小程序…」「帮我一步步操作…」时用本工具; 不要只用 open_app_by_name 打开 App 就结束。立即返回 taskId, 之后用 taskStatus 查进度。</description>
    <parameters>
      <dataTypeMetadata>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </dataTypeMetadata>
      <id>unused</id>
      <isRequired>true</isRequired>
      <name>task</name>
      <description>要完成的中文任务原话, 例如: 去微信搜索三角洲行动并进入小程序查看今日密码</description>
    </parameters>
    <response>
      <id>unused</id>
      <valueType>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </valueType>
    </response>
    <functionId>com.ljq.ga.amoo.GaAppFunctionService#startTask</functionId>
  </appfunction>
  <appfunction>
    <id>com.ljq.ga.amoo.GaAppFunctionService#taskStatus</id>
    <enabledByDefault>true</enabledByDefault>
    <description>查询 GAgent 手机自动化任务的进度与结果: 返回 state(running/done)、当前步骤摘要、最终回复。startTask 返回后轮询用。</description>
    <parameters>
      <dataTypeMetadata>
        <id>unused</id>
        <isNullable>true</isNullable>
        <type>8</type>
      </dataTypeMetadata>
      <id>unused</id>
      <isRequired>false</isRequired>
      <name>taskId</name>
      <description>startTask 返回的 taskId; 留空表示查询最近一次任务</description>
    </parameters>
    <response>
      <id>unused</id>
      <valueType>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </valueType>
    </response>
    <functionId>com.ljq.ga.amoo.GaAppFunctionService#taskStatus</functionId>
  </appfunction>
  <appfunction>
    <id>com.ljq.ga.amoo.GaAppFunctionService#cancelTask</id>
    <enabledByDefault>true</enabledByDefault>
    <description>取消 GAgent 正在执行的手机自动化任务。</description>
    <parameters>
      <dataTypeMetadata>
        <id>unused</id>
        <isNullable>true</isNullable>
        <type>8</type>
      </dataTypeMetadata>
      <id>unused</id>
      <isRequired>false</isRequired>
      <name>taskId</name>
      <description>要取消的 taskId; 留空表示取消最近一次任务</description>
    </parameters>
    <response>
      <id>unused</id>
      <valueType>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </valueType>
    </response>
    <functionId>com.ljq.ga.amoo.GaAppFunctionService#cancelTask</functionId>
  </appfunction>
</appfunctions>